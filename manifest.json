{
  "manifest_version": 3,
  "name": "Sidebarr 瀏覽器側邊欄工具",
  "version": "2026.0.14",
  "description": "頁面內建常駐面板列，一鍵加入常用網站並在側邊欄開啟，面板列永遠停靠瀏覽器最右側",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "sidePanel",
    "tabs",
    "scripting",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>",
    "chrome-extension://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "切換側邊欄（開啟 Google / 收起面板）"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["clipboard-patch.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtube-nocookie.com/*", "*://youtube-nocookie.com/*"],
      "js": ["iframe-layout-fix.js"],
      "css": ["iframe-layout-fix.css"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*", "*://youtube.com/*", "*://*.youtube-nocookie.com/*", "*://youtube-nocookie.com/*"],
      "js": ["youtube-adblock.js"],
      "css": ["youtube-adblock.css"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "remove_xframe",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "adblock",
        "enabled": true,
        "path": "adblock-rules.json"
      }
    ]
  },
  "action": {
    "default_title": "切換側邊欄",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
